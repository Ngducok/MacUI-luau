/dist/*
!/dist/MacUI.luau
!/examples/
/examples/*
!/examples/executor.luau
!/tools/
/tools/*
!/tools/build.mjs
!/tools/test.project.json
!/tests/
/tests/*
!/tests/init.luau
!/tests/bundle.test.mjs
